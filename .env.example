# Database
DATABASE_URL="postgresql://user:password@localhost:5432/event-grounds"
# Paystack
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxx"
# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Resend
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# Platform Commission (2%)
NEXT_PUBLIC_COMMISSION_RATE="0.02"
COMMISSION_RATE="0.02"
# Auth (Auth.js / NextAuth) - generate with: npx auth secret
AUTH_SECRET=""
# Admin (password is bcrypt-hashed; generate with:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))")
# IMPORTANT: Next.js's .env loader expands "$name" as a variable reference, and
# bcrypt hashes are full of "$" segments (e.g. $2b$10$...) - escape every "$" as
# "\$" or the hash gets silently mangled. Example: "$2b$10$abc" -> "\$2b\$10\$abc"
ADMIN_EMAIL="admin@eventgrounds.com"
ADMIN_PASSWORD_HASH=""
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="EventGrounds"

# Rate limiting (optional) - without these, rate limits fall back to an
# in-memory counter that only holds within a single running process. Get a
# free database at upstash.com (Redis > Create Database > REST API section).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (optional) - without SENTRY_DSN set, no errors are sent
# anywhere; local structured logging (src/lib/logger.ts) still works either
# way. Get a DSN at sentry.io (Settings > Projects > <project> > Client Keys).
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are usually the same value - server
# and browser errors are captured separately, so both need it set.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps for readable stack traces in Sentry -
# skipped automatically if unset (Sentry still works, traces are minified).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Analytics (optional) - without this, no analytics script loads at all.
# Plausible is cookie-less, so it doesn't need a cookie-consent banner.
# Get a site at plausible.io (Add a website), domain is exactly as registered
# there (e.g. "eventgrounds.com"), not a URL.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
